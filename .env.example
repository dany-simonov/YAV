# Server-side Appwrite Function settings (do not put provider secrets in web/.env).
RATE_LIMIT_ENABLED=true
APPWRITE_FUNCTION_API_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_FUNCTION_PROJECT_ID=
APPWRITE_DATABASE_ID=yav
APPWRITE_RATE_LIMITS_TABLE_ID=rate_limits
APPWRITE_QUOTA_RESERVATIONS_TABLE_ID=quota_reservations
APPWRITE_USER_QUOTA_GENERATIONS_TABLE_ID=user_quota_generations
APPWRITE_ADMIN_AUDIT_TABLE_ID=admin_audit_log
RATE_LIMIT_IP_HMAC_KEY=
SYSTEM_ADMIN_USER_IDS=

# Canonical subscription defaults. Individual server-managed user overrides
# are stored in Appwrite, never in browser-visible environment variables.
FREE_DAILY_LIMIT=3
FREE_HEAVY_MEDIA_DAILY_LIMIT=1
PREMIUM_MONTHLY_LIMIT=100
PRO_HEAVY_MEDIA_MONTHLY_LIMIT=25
ENTERPRISE_MONTHLY_LIMIT=1000
ENTERPRISE_HEAVY_MEDIA_MONTHLY_LIMIT=250
CUSTOM_MONTHLY_LIMIT=100
CUSTOM_HEAVY_MEDIA_MONTHLY_LIMIT=25

NEW_USER_PERIOD_DAYS=7
NEW_USER_TOTAL_DAILY=4
NEW_USER_TOTAL_FIRST_7D=10
NEW_USER_TEXT_DAILY=3
NEW_USER_HYBRID_DAILY=1
NEW_USER_IMAGE_DAILY=1
NEW_USER_AUDIO_WINDOW_HOURS=72
NEW_USER_AUDIO_PER_WINDOW=1
NEW_USER_VIDEO_FIRST_7D=1

IP_TOTAL_DAILY=8
IP_HEAVY_MEDIA_DAILY=2

NEW_USER_TEXT_MAX_CHARS=5000
NEW_USER_HYBRID_MAX_CHARS=3000
NEW_USER_IMAGE_MAX_BYTES=5242880
NEW_USER_AUDIO_MAX_BYTES=5242880
NEW_USER_VIDEO_MAX_BYTES=10485760

GLOBAL_GEMINI_OPERATIONS_DAILY=100
GLOBAL_SIGHTENGINE_DAILY=50
GLOBAL_SIGHTENGINE_MONTHLY=1500
GLOBAL_AIORNOT_WORDS_DAILY=20000
GLOBAL_AIORNOT_WORDS_MONTHLY=600000
GLOBAL_SAPLING_CHARS_DAILY=20000
GLOBAL_SAPLING_CHARS_MONTHLY=120000
